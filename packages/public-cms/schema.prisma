  id               Int    @id @default(autoincrement())
  name             String @default("")
  modelSrc         String @default("")
  cameraHelperData Json?  @default("{\"plainPois\":[],\"animationClip\":null,\"modelObjs\":[]}")
  created_by       User?  @relation("ScrollableThreeModel_created_by", fields: [created_byId], references: [id])
