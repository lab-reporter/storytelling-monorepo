// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                                   Int                    @id @default(autoincrement())
  name                                 String                 @default("")
  email                                String                 @unique @default("")
  password                             String
  role                                 String
  createdAt                            DateTime?              @default(now())
  updatedAt                            DateTime?              @updatedAt
  from_Audio_created_by                Audio[]                @relation("Audio_created_by")
  from_Video_created_by                Video[]                @relation("Video_created_by")
  from_Photo_created_by                Photo[]                @relation("Photo_created_by")
  from_ScrollToAudio_created_by        ScrollToAudio[]        @relation("ScrollToAudio_created_by")
  from_ScrollableVideo_created_by      ScrollableVideo[]      @relation("ScrollableVideo_created_by")
  from_ScrollableThreeModel_created_by ScrollableThreeModel[] @relation("ScrollableThreeModel_created_by")
  from_PuzzlePhotoInfra_created_by     PuzzlePhotoInfra[]     @relation("PuzzlePhotoInfra_created_by")
}

model Audio {
  id            Int       @id @default(autoincrement())
  name          String    @default("")
  file_filesize Int?
  file_filename String?
  description   String    @default("")
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  created_by    User?     @relation("Audio_created_by", fields: [created_byId], references: [id])
  created_byId  Int?      @map("created_by")

  @@index([created_byId])
}

model Video {
  id            Int       @id @default(autoincrement())
  name          String    @default("")
  file_filesize Int?
  file_filename String?
  description   String    @default("")
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  created_by    User?     @relation("Video_created_by", fields: [created_byId], references: [id])
  created_byId  Int?      @map("created_by")

  @@index([created_byId])
}

model Photo {
  id                  Int       @id @default(autoincrement())
  name                String    @default("")
  imageFile_id        String?
  imageFile_filesize  Int?
  imageFile_width     Int?
  imageFile_height    Int?
  imageFile_extension String?
  description         String    @default("")
  created_at          DateTime? @default(now())
  updated_at          DateTime? @updatedAt
  created_by          User?     @relation("Photo_created_by", fields: [created_byId], references: [id])
  created_byId        Int?      @map("created_by")

  @@index([created_byId])
}

model ScrollToAudio {
  id           Int       @id @default(autoincrement())
  name         String    @default("")
  audioSrc     String    @default("")
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt
  created_by   User?     @relation("ScrollToAudio_created_by", fields: [created_byId], references: [id])
  created_byId Int?      @map("created_by")

  @@index([created_byId])
}

model ScrollableVideo {
  id             Int    @id @default(autoincrement())
  name           String @default("")
  videoSrc       String @default("")
  mobileVideoSrc String @default("")
  editorState    Json?  @default("{\"captions\":[],\"videoSrc\":\"\",\"videoDuration\":0,\"theme\":\"light_mode\",\"secondsPer100vh\":1.5}")
  customCss      String @default("\n.scrollable-video {\n  /* 覆寫所有區塊預設的 css */\n  .section {\n    /* 例如：background-color: pink; */\n\n    /* 覆寫所有區塊內圖說預設的 css */\n    .draft-image-desc {\n    }\n\n    /* 覆寫所有區塊內抽言預設的 css */\n    .draft-blockquote {\n    }\n\n    /* 覆寫所有區塊內 H2 預設的 css */\n    .draft-header-two h2 {\n    }\n\n    /* 覆寫所有區塊內 H3 預設的 css */\n    .draft-header-three h3 {\n    }\n\n    /* 覆寫所有區塊內內文預設的 css */\n    .draft-paragraph {\n    }\n\n    /* 覆寫所有區塊內超連結預設的 css */\n    .draft-link {\n    }\n\n    /* 覆寫所有區塊內 annotation 預設的 css */\n    .annotation-wrapper {\n    }\n    .annotation-title {\n    }\n    .annotation-body {\n    }\n  }\n\n}\n      ")
  created_by     User?  @relation("ScrollableVideo_created_by", fields: [created_byId], references: [id])
  created_byId   Int?   @map("created_by")

  @@index([created_byId])
}

